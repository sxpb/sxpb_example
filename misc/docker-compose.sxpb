(version "3.8")
(services
  (web
    (image nginx:latest)
    (ports (())
      "8080:80"
    )
    (volumes (())
      "./nginx.conf:/etc/nginx/nginx.conf"
    )
  )
  (db
    (image postgres:13)
    (environment (())
      "POSTGRES_USER=user"
      "POSTGRES_PASSWORD=password"
      "POSTGRES_DB=mydb"
    )
  )
)
